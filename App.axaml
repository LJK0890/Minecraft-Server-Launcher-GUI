<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MinecraftServerLauncher.App"
             xmlns:local="using:MinecraftServerLauncher"
             RequestedThemeVariant="Light">
             <!-- 界面按浅色设计（白色卡片 + 浅灰底），这里固定为 Light。
                  若跟随系统（Default），系统处于深色模式时 Fluent 主题会把
                  未显式指定颜色的文字渲染成浅色，白底上直接看不见。 -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>